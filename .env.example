# Copie para .env e ajuste conforme o ambiente. NÃO versione o .env real.

# --- Storage -------------------------------------------------------------
# local (padrão) grava em ./data/lakehouse ; s3 grava em s3a://<bucket>/<prefix>
STORAGE_BACKEND=local
# delta (produção/Databricks) | parquet (CI / ambientes sem Maven)
TABLE_FORMAT=delta

# --- AWS S3 (quando STORAGE_BACKEND=s3) ----------------------------------
S3_BUCKET=meu-bucket-lakehouse
S3_PREFIX=servicedesk
AWS_REGION=us-east-1
# Credenciais via cadeia padrão da AWS:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Volume de dados sintéticos ------------------------------------------
TICKETS_PER_RUN=20000

# --- Postgres (camada de consumo) ----------------------------------------
PG_ENABLED=true
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=servicedesk
PG_USER=servicedesk
PG_PASSWORD=servicedesk
PG_SCHEMA=gold
